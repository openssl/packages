#!/bin/sh
# openssl-fips-enable — choose which FIPS provider module OpenSSL @STREAM@ uses,
# and activate FIPS mode for this stream.
#
#   openssl-fips-enable list
#   openssl-fips-enable <module>          # e.g. 3.1.2 (validated) or 4.0 (stream)
#   openssl-fips-enable verify
#   openssl-fips-enable disable
#
# Two kinds of module live under /opt/openssl/fips/, selected by ABSOLUTE PATH in
# the generated configuration (the config(5) "module" key):
#   /opt/openssl/fips/<X.Y.Z>/  NIST-validated, pinned source version, never
#                               changes (openssl-fips<X.Y.Z>-upstream)
#   /opt/openssl/fips/<X.Y>/    built from the X.Y stream's current source,
#                               NOT validated, upgrades with the stream
#                               (openssl<X.Y>-upstream-fips)
set -eu

STREAM="@STREAM@"
PREFIX="@PREFIX@"
FIPSROOT=/opt/openssl/fips
SSLDIR="/etc/opt/openssl/@STREAM@"
OSSL="$PREFIX/bin/openssl"
CNF_TEMPLATE="$PREFIX/share/openssl-fips.cnf.in"
ENABLED="$SSLDIR/fips-enabled"

usage() {
    echo "usage: openssl-fips-enable list | <module> | verify | disable" >&2
    exit 1
}

# A validated module ships a 'validated' file beside fips.so naming its NIST
# CMVP certificate. A stream companion module ships a 'version' file instead —
# its directory is named after the stream, so the actual source version it was
# built from is recorded there. Argument: module directory name.
validation_note() {
    if [ -r "$FIPSROOT/$1/validated" ]; then
        printf 'validated, %s' "$(cat "$FIPSROOT/$1/validated")"
    elif [ -r "$FIPSROOT/$1/version" ]; then
        printf 'version %s, tracks the %s stream, NOT NIST-validated' \
            "$(cat "$FIPSROOT/$1/version")" "$1"
    else
        printf 'NOT NIST-validated'
    fi
}

cmd_list() {
    echo "OpenSSL stream:   $STREAM"
    echo "FIPS modules installed:"
    found=
    for f in "$FIPSROOT"/*/fips.so; do
        [ -e "$f" ] || continue
        found=1
        v=$(basename "$(dirname "$f")")
        printf '  %-10s %s\n' "$v" "($(validation_note "$v"))"
    done
    [ -n "$found" ] || \
        echo "  (none — install an openssl-fips<version>-upstream package," \
             "or openssl<stream>-upstream-fips for the stream's own module)"
    if [ -r "$ENABLED" ]; then
        echo "Enabled for $STREAM: $(cat "$ENABLED")"
    else
        echo "Enabled for $STREAM: none"
    fi
}

cmd_enable() {
    ver="$1"
    module="$FIPSROOT/$ver/fips.so"
    [ -x "$OSSL" ]    || { echo "stream $STREAM is not installed" >&2; exit 1; }
    [ -e "$module" ]  || { echo "FIPS module $ver is not installed" >&2; exit 1; }
    [ -r "$CNF_TEMPLATE" ] || { echo "missing $CNF_TEMPLATE" >&2; exit 1; }

    # Generate fipsmodule.cnf — this runs the module self-tests on this machine.
    # OPENSSL_CONF=/dev/null: openssl loads the default config at startup, and
    # when FIPS is already enabled with a configuration that no longer matches
    # the module (the exact state enable exists to repair — e.g. right after a
    # module upgrade), that load fails before fipsinstall could run.
    OPENSSL_CONF=/dev/null "$OSSL" fipsinstall -pedantic -provider_name fips \
        -module "$module" -out "$SSLDIR/fipsmodule.cnf"

    printf 'module = %s\n' "$module" >> "$SSLDIR/fipsmodule.cnf"

    OPENSSL_CONF=/dev/null "$OSSL" fipsinstall -provider_name fips \
        -module "$module" -in "$SSLDIR/fipsmodule.cnf" -verify

    sed -e "s|@SSLDIR@|$SSLDIR|g" -e "s|@FIPS_VERSION@|$ver|g" \
        "$CNF_TEMPLATE" > "$SSLDIR/openssl.cnf"

    printf '%s\n' "$ver" > "$ENABLED"

    echo "FIPS module $ver enabled for OpenSSL $STREAM."
    echo "Check with: $OSSL list -providers"
}

cmd_verify() {
    [ -r "$ENABLED" ] || { echo "FIPS is not enabled for stream $STREAM" >&2; exit 1; }
    ver=$(cat "$ENABLED")
    module="$FIPSROOT/$ver/fips.so"
    [ -e "$module" ] || {
        echo "stream $STREAM: enabled module $ver is no longer installed" >&2; exit 1; }
    # OPENSSL_CONF=/dev/null so the check itself runs even when the active
    # configuration is the thing that is broken (see cmd_enable).
    if OPENSSL_CONF=/dev/null "$OSSL" fipsinstall -provider_name fips \
           -module "$module" -in "$SSLDIR/fipsmodule.cnf" -verify; then
        echo "stream $STREAM: fipsmodule.cnf matches FIPS module $ver."
    else
        echo "stream $STREAM: STALE fipsmodule.cnf — module $ver changed since it" >&2
        echo "was enabled. Re-run: openssl-fips-enable $ver" >&2
        exit 1
    fi
}

cmd_disable() {
    [ -f "$SSLDIR/openssl.cnf.dist" ] && cp "$SSLDIR/openssl.cnf.dist" "$SSLDIR/openssl.cnf"
    rm -f "$SSLDIR/fipsmodule.cnf" "$ENABLED"
    echo "FIPS disabled for OpenSSL $STREAM (default configuration restored)."
}

[ $# -ge 1 ] || usage
case "$1" in
    list)    [ $# -eq 1 ] || usage; cmd_list ;;
    verify)  [ $# -eq 1 ] || usage; cmd_verify ;;
    disable) [ $# -eq 1 ] || usage; cmd_disable ;;
    -*)      usage ;;
    *)       [ $# -eq 1 ] || usage; cmd_enable "$1" ;;
esac
