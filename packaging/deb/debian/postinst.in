#!/bin/sh
set -e

PREFIX=/opt/openssl/@STREAM@

if [ "$1" = "configure" ]; then
    # Honours USE_SYSTEM_TRUST_ANCHORS from the installing environment, else the
    # recorded choice, else the system anchors. Same code path as the rpm %post.
    "$PREFIX/bin/openssl-trust-anchors" apply
fi

#DEBHELPER#
