#!/usr/bin/make -f
# FIPS provider module packaging, two modes (see build-in-container.sh):
# validated (pinned per source version) and stream companion (FIPS_STREAM set,
# named after the stream, upgrades with it). Configured with `enable-fips` and
# no other OpenSSL options, per the module Security Policy.

FIPSVER     = @FIPSVER@
FIPS_CERT   = @FIPS_CERT@
FIPS_STREAM = @FIPS_STREAM@
MODDIR      = @MODDIR@
TMP     = $(CURDIR)/debian/tmp

# Only how many compiler processes run at once; the Security Policy's command
# and the build environment are unchanged.
JOBS ?= $(shell nproc)

%:
	dh $@

# The Security Policy's exact command (3.1.2 cert #4985, §11.1 step 1). The
# environment is left as the packaging tools set it: the SP prescribes a
# command, not an environment.
override_dh_auto_configure:
	./Configure enable-fips

# providers/fips.so is MODULES{fips}. Skipping the test programs the default
# target would also build leaves fips.so byte-identical.
override_dh_auto_build:
	$(MAKE) -j$(JOBS) build_modules

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 providers/fips.so $(TMP)/opt/openssl/fips/$(MODDIR)/fips.so
	# Records the CMVP certificate; absent means not NIST-validated.
	if [ -n "$(FIPS_CERT)" ]; then \
	    echo "NIST CMVP certificate #$(FIPS_CERT)" \
	        > $(TMP)/opt/openssl/fips/$(MODDIR)/validated; \
	fi
	# The companion's dir is the stream, so record the source version beside it.
	if [ -n "$(FIPS_STREAM)" ]; then \
	    echo "$(FIPSVER)" > $(TMP)/opt/openssl/fips/$(MODDIR)/version; \
	fi

# Fail if anything staged into debian/tmp is not packaged. Explicit because the
# oldest target only has debhelper 12, where it is not the default.
override_dh_missing:
	dh_missing --fail-missing

# fips.so is a self-contained plugin: no SONAME to advertise, no ldconfig.
override_dh_makeshlibs:

override_dh_auto_clean:
	[ ! -f Makefile ] || $(MAKE) distclean
